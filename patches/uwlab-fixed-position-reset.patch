+@configclass
+class ObjectFixedPositionEEAnywhereEventCfg(ResetStatesBaseEventCfg):
+    """Fixed peg position reset: peg at exactly the same position every episode.
+
+    Same structure as ObjectAnywhereEEAnywhereEventCfg but with peg pose_range
+    collapsed to a single point (chosen as the midpoint of the original range).
+    EE pose_range_b stays at original range so IK can always find a valid solution.
+    Hole (receptive_object) is kinematic and always at scene default position.
+    """
+    reset_insertive_object_pose = EventTerm(
+        func=task_mdp.reset_root_states_uniform,
+        mode="reset",
+        params={
+            "pose_range": {
+                # Midpoint of original ObjectAnywhereEEAnywhere range:
+                # x:(0.3,0.55) y:(-0.1,0.5) z:(0.0,0.3)
+                "x": (0.425, 0.425),  # Fixed X (midpoint)
+                "y": (0.20, 0.20),    # Fixed Y (midpoint)
+                "z": (0.15, 0.15),    # Fixed Z (midpoint)
+                "roll": (0.0, 0.0),
+                "pitch": (0.0, 0.0),
+                "yaw": (0.0, 0.0),
+            },
+            "velocity_range": {},
+            "asset_cfgs": {"insertive_object": SceneEntityCfg("insertive_object")},
+            "offset_asset_cfg": SceneEntityCfg("ur5_metal_support"),
+            "use_bottom_offset": True,
+        },
+    )
+
+    reset_end_effector_pose = EventTerm(
+        func=task_mdp.reset_end_effector_round_fixed_asset,
+        mode="reset",
+        params={
+            "fixed_asset_cfg": SceneEntityCfg("robot"),
+            "fixed_asset_offset": None,
+            "pose_range_b": {
+                "x": (0.3, 0.7),
+                "y": (-0.4, 0.4),
+                "z": (0.0, 0.5),
+                "roll": (0.0, 0.0),
+                "pitch": (np.pi / 4, 3 * np.pi / 4),
+                "yaw": (np.pi / 2, 3 * np.pi / 2),
+            },
+            "robot_ik_cfg": SceneEntityCfg(
+                "robot", joint_names=["shoulder.*", "elbow.*", "wrist.*"], body_names="robotiq_base_link"
+            ),
+        },
+    )
+
