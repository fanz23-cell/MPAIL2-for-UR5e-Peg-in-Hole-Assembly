+    def _clone_observation(self, obs: dict[str, Any]) -> dict[str, Any]:
+        """Clone observation tensors before reset mutates simulator buffers."""
+        cloned = {}
+        for key, value in obs.items():
+            if torch.is_tensor(value):
+                cloned[key] = value.clone()
+            elif isinstance(value, dict):
+                cloned[key] = self._clone_observation(value)
+            else:
+                cloned[key] = value
+        return cloned
+
+    def _snapshot_observation_history(self) -> dict[str, dict[str, tuple[torch.Tensor | None, torch.Tensor, int]]]:
+        """Snapshot observation history buffers before a temporary terminal obs compute."""
+        snapshot = {}
+        history_buffers = getattr(self.observation_manager, "_group_obs_term_history_buffer", {})
+        for group_name, term_buffers in history_buffers.items():
+            snapshot[group_name] = {}
+            for term_name, buffer in term_buffers.items():
+                stored = None if buffer._buffer is None else buffer._buffer.clone()
+                snapshot[group_name][term_name] = (stored, buffer._num_pushes.clone(), buffer._pointer)
+        return snapshot
+
+    def _restore_observation_history(
+        self, snapshot: dict[str, dict[str, tuple[torch.Tensor | None, torch.Tensor, int]]]
+    ):
+        """Restore observation history buffers after terminal obs capture."""
+        history_buffers = getattr(self.observation_manager, "_group_obs_term_history_buffer", {})
+        for group_name, term_snapshots in snapshot.items():
+            for term_name, (stored, num_pushes, pointer) in term_snapshots.items():
+                buffer = history_buffers[group_name][term_name]
+                buffer._buffer = None if stored is None else stored.clone()
+                buffer._num_pushes = num_pushes.clone()
+                buffer._pointer = pointer
